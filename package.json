{
	"name": "@tstibbs/smart-home-integration-functions",
	"private": true,
	"engines": {
		"node": ">=22",
		"pnpm": ">=11.7",
		"npm": "9999.9.9-use-pnpm"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"onFail": "error"
		}
	},
	"type": "module",
	"dependencies": {
		"axios": "^1.18.0",
		"dotenv": "^16.5.0",
		"exponential-backoff": "^3.1.3",
		"modofun": "^1.2.2"
	},
	"devDependencies": {
		"@tstibbs/cloud-core-utils": "github:tstibbs/cloud-core#path:/aws/utils",
		"aws-cdk": "^2.1126.0",
		"aws-cdk-lib": "^2.258.1",
		"body-parser": "^2.3.0",
		"esbuild": "^0.28.1",
		"express": "^5.2.1",
		"husky": "^4.2.5",
		"jest": "^30.4.2",
		"lint-staged": "^17.0.7",
		"node-watch-changes": "^2.0.4",
		"prettier": "^3.8.4"
	},
	"scripts": {
		"preinstall": "git config core.hooksPath .project/hooks",
		"dev": "nodemon --watch ./src ./test/index.js",
		"cdk-dev": "cdk-tools watch \"cdk-dev:_serve\"",
		"cdk-dev:_serve": "LOAD_HANDLER_FROM_CDK=true nodemon --watch cdk.out --watch ./test/index.js ./test/index.js",
		"test": "APP_ID=dummy CF_ROLE_ARN=dummy node test/basic.js && cdk-tools testcdk",
		"testsynth": "cdk-tools testsynth",
		"dryrun": "cdk-tools dryrun",
		"deploy": "cdk-tools deploy",
		"everything": "pnpm run testsynth && pnpm run test && pnpm run deploy"
	}
}
